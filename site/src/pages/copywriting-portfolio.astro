---
import Base from '../layouts/Base.astro';

const deck = [
  { no: '01', kicker: 'PORTFOLIO', title: '文案策划作品集', subtitle: '小红书穿搭笔记｜个人公众号运营｜混沌学院服务号｜活动策划文案', body: '以奶黄色为主视觉，把作品图片里的穿搭种草、知识服务与活动传播，整理成一套可展示、可面试、可继续扩展的 PPT 式作品集。', chips: ['活泼', '艺术化', '有栏目', '有转化'] },
  { no: '02', kicker: 'PROFILE', title: '我能提供什么', subtitle: '从灵感捕捉到发布复盘的完整内容链路', body: '擅长把“产品卖点 / 课程价值 / 活动亮点”翻译成用户愿意点开、愿意收藏、愿意行动的内容语言。', bullets: ['选题规划：热点、用户情绪、品牌节点三线并行', '文案输出：标题、正文、海报短句、H5、字幕图、推文', '运营复盘：阅读、互动、收藏、预约转化沉淀模板'] },
  { no: '03', kicker: 'REDNOTE', title: '小红书穿搭笔记', subtitle: '把一双鞋写成一个可代入的生活场景', body: '以 adidas Originals 相关穿搭图为参考，强化“复古鞋柜、浅色系、甜酷风、假日随拍”等关键词，形成轻松、带画面、适合收藏的种草语气。', bullets: ['标题：短钩子 + 场景词，例如「挑一双，盘活你的复古鞋柜」', '正文：三行一停顿，先氛围后单品，再落到穿搭逻辑', '标签：品牌词 + 单品词 + 场景词 + 人群词，提高搜索命中'] },
  { no: '04', kicker: 'COPY SAMPLE', title: '穿搭笔记样张', subtitle: '甜酷 / 复古 / 轻运动三类语气', body: '挑一双，盘活你的复古鞋柜。薄底鞋轻盈又通透，把街角、阳光和少年气一起穿上脚。今天不讲大道理，只拆一套甜酷风搭配：上身利落，裙摆留风，鞋底负责把态度踩响。', chips: ['#adidasOriginals', '#SAMBA', '#ootdinspo', '#甜酷穿搭'] },
  { no: '05', kicker: 'WECHAT', title: '个人公众号运营', subtitle: '把个人审美沉淀成稳定栏目', body: '公众号不只追热点，更要建立“可持续的人格”。通过栏目化内容，把生活观察、审美灵感与项目复盘整理成长期资产。', bullets: ['栏目：灵感手账 / 月度复盘 / 城市漫游 / 作品拆解', '结构：故事开场 — 观点展开 — 清单总结 — 互动提问', '运营：封面统一、摘要前置、菜单承接、评论区二次互动'] },
  { no: '06', kicker: 'HUNDUN', title: '混沌学院服务号', subtitle: '让知识产品被看见，也被预约', body: '围绕课程上新、知识卡、H5、字幕图和共学设计，使用“热点问题—底层逻辑—行动建议”的结构，让复杂议题更易读、更易转化。', bullets: ['推销类：先抛热点问题，再解释为什么值得听', '学习材料：知识卡提炼课程金句，预约后领取资料', '共学设计：预热思考、带问题听课、课后共学讨论'] },
  { no: '07', kicker: 'EVENT', title: '活动策划文案', subtitle: '从预热到复盘，都要有一句能被记住的话', body: '活动文案重点不是堆信息，而是设计情绪节奏：先制造期待，再明确参与理由，最后沉淀高光瞬间。', bullets: ['主题命名：短、亮、有画面，例如「活力上新，潮礼全开」', '传播节奏：悬念预热 / 嘉宾亮点 / 福利提醒 / 现场快讯', '物料覆盖：主视觉标语、邀请函、主持串词、推文复盘'] },
  { no: '08', kicker: 'METHOD', title: '我的内容方法论', subtitle: '看图定调 → 拆解卖点 → 设计结构 → 复盘优化', body: '先判断图片和项目的气质，再把信息翻译为用户语言；标题负责停留，正文负责代入，标签与 CTA 负责搜索和行动。', chips: ['场景化', '情绪化', '结构化', '可复用'] },
];
---
<Base
  title="PPT形式文案策划作品集｜小红书穿搭笔记 / 公众号运营 / 服务号 / 活动策划"
  titleEn="Copywriting Portfolio Deck"
  titleZh="PPT形式文案策划作品集"
  description="奶黄色艺术风 PPT 形式文案策划作品集，展示小红书穿搭笔记、个人公众号运营、混沌学院服务号与活动策划文案能力。"
  noindex={true}>
  <main class="deck-page" aria-label="PPT形式文案策划作品集">
    <nav class="deck-nav" aria-label="PPT页码导航">
      {deck.map((slide) => <a href={`#slide-${slide.no}`}>{slide.no}</a>)}
    </nav>

    <div class="deck-shell">
      {deck.map((slide, index) => (
        <section class={`slide slide-${index + 1}`} id={`slide-${slide.no}`} aria-label={`${slide.no} ${slide.title}`}>
          <div class="slide-frame">
            <header class="slide-head">
              <span>{slide.kicker}</span>
              <b>{slide.no} / {deck.length.toString().padStart(2, '0')}</b>
            </header>
            <div class="slide-content">
              <div class="copy-block">
                <p class="overline">奶黄色 · Copy Planning Deck</p>
                <h1>{slide.title}</h1>
                <h2>{slide.subtitle}</h2>
                <p class="body-copy">{slide.body}</p>
                {slide.bullets && <ul>{slide.bullets.map((item) => <li>{item}</li>)}</ul>}
                {slide.chips && <div class="chips">{slide.chips.map((chip) => <span>{chip}</span>)}</div>}
              </div>
              <aside class="visual-card" aria-hidden="true">
                <div class="blob"></div>
                <div class="phone-card">
                  <span class="dotline"><i></i><i></i><i></i></span>
                  <strong>{slide.kicker}</strong>
                  <p>{index === 0 ? 'COPY / CONTENT / EVENT' : slide.title}</p>
                </div>
                <div class="sticky-note">✦ {slide.no}</div>
              </aside>
            </div>
            <footer class="slide-foot"><span>Portfolio by Copy Planner</span><span>奶油黄视觉提案</span></footer>
          </div>
        </section>
      ))}
    </div>
  </main>
</Base>

<style>
  .deck-page { min-height: 100vh; background: #f6d469; color: #2d2414; overflow-x: hidden; }
  .deck-nav { position: fixed; z-index: 20; top: 50%; right: 18px; display: grid; gap: 8px; transform: translateY(-50%); }
  .deck-nav a { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: rgb(255 255 255 / 66%); color: #6f4a00; text-decoration: none; font-size: 12px; font-weight: 900; box-shadow: 0 10px 28px rgb(92 58 0 / 14%); }
  .deck-shell { display: grid; gap: 32px; padding: 32px 72px 48px 32px; }
  .slide { min-height: calc(100vh - 64px); display: grid; place-items: center; scroll-margin: 24px; }
  .slide-frame { position: relative; width: min(1180px, 100%); aspect-ratio: 16 / 9; min-height: 620px; border-radius: 34px; padding: 34px 42px; overflow: hidden; background: radial-gradient(circle at 80% 18%, #ffe994 0 16%, transparent 28%), linear-gradient(135deg, #fffaf0 0%, #ffeeb6 54%, #ffd96b 100%); box-shadow: 0 32px 90px rgb(82 50 0 / 24%); }
  .slide-frame::before { content: ''; position: absolute; inset: 18px; border: 1px solid rgb(98 70 15 / 16%); border-radius: 26px; pointer-events: none; }
  .slide-frame::after { content: '✺'; position: absolute; right: 72px; bottom: 38px; font-size: 120px; line-height: 1; color: rgb(240 138 36 / 18%); }
  .slide-head, .slide-foot { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: #8d650b; }
  .slide-head b, .slide-foot span { font-weight: 900; }
  .slide-content { position: relative; z-index: 2; display: grid; grid-template-columns: 1.15fr .85fr; gap: 42px; align-items: center; height: calc(100% - 54px); }
  .overline { display: inline-flex; width: fit-content; margin-bottom: 18px; padding: 8px 13px; border-radius: 999px; background: #fff7cf; color: #a46a00; font-size: 13px; font-weight: 900; letter-spacing: .08em; }
  h1 { max-width: 760px; margin: 0; font-size: clamp(50px, 6.6vw, 92px); line-height: .92; letter-spacing: -.055em; }
  h2 { max-width: 720px; margin: 22px 0 0; font-size: clamp(22px, 2.5vw, 34px); line-height: 1.25; color: #9d5d00; letter-spacing: -.02em; }
  .body-copy { max-width: 740px; margin-top: 26px; font-size: 22px; line-height: 1.75; color: #5d4a25; }
  ul { display: grid; gap: 12px; margin: 26px 0 0; padding: 0; list-style: none; }
  li { position: relative; padding-left: 24px; font-size: 20px; line-height: 1.55; color: #4c3c1c; }
  li::before { content: ''; position: absolute; left: 0; top: .72em; width: 9px; height: 9px; border-radius: 50%; background: #f08a24; }
  .chips { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .chips span { padding: 10px 16px; border-radius: 999px; background: rgb(255 255 255 / 72%); border: 1px solid rgb(97 66 0 / 12%); color: #704900; font-weight: 900; }
  .visual-card { position: relative; min-height: 430px; display: grid; place-items: center; }
  .blob { position: absolute; width: 360px; height: 360px; border-radius: 46% 54% 58% 42%; background: linear-gradient(145deg, #ffbd59, #fff3bc); transform: rotate(-12deg); box-shadow: inset 0 0 0 20px rgb(255 255 255 / 28%); }
  .phone-card { position: relative; width: min(320px, 86%); min-height: 390px; border-radius: 36px; padding: 30px; background: rgb(255 255 255 / 74%); border: 1px solid rgb(255 255 255 / 86%); box-shadow: 0 24px 80px rgb(99 63 0 / 18%); backdrop-filter: blur(12px); }
  .dotline { display: flex; gap: 7px; margin-bottom: 54px; }
  .dotline i { width: 9px; height: 9px; border-radius: 50%; background: #f08a24; }
  .dotline i:nth-child(2) { background: #ffd84d; }
  .dotline i:nth-child(3) { background: #2d2414; }
  .phone-card strong { display: block; font-size: 16px; color: #9d5d00; letter-spacing: .12em; }
  .phone-card p { margin-top: 18px; font-size: 34px; line-height: 1.1; font-weight: 900; letter-spacing: -.04em; }
  .sticky-note { position: absolute; right: 18px; bottom: 52px; transform: rotate(8deg); padding: 18px 22px; border-radius: 18px; background: #fff1a8; font-size: 34px; font-weight: 900; box-shadow: 0 16px 34px rgb(80 50 0 / 16%); }
  .slide-foot { position: absolute; left: 42px; right: 42px; bottom: 28px; }
  .slide-3 .blob, .slide-4 .blob { background: linear-gradient(145deg, #ff9fb2, #fff3bc); }
  .slide-6 .blob { background: linear-gradient(145deg, #ffda38, #d8f6a8); }
  .slide-7 .blob { background: linear-gradient(145deg, #ff8f3d, #ffeeb6); }
  @media (max-width: 900px) { .deck-nav { display: none; } .deck-shell { padding: 18px; } .slide { min-height: auto; } .slide-frame { aspect-ratio: auto; min-height: 0; padding: 28px 22px 72px; } .slide-content { grid-template-columns: 1fr; height: auto; gap: 20px; } .visual-card { min-height: 260px; } .blob { width: 240px; height: 240px; } .phone-card { min-height: 230px; } .body-copy, li { font-size: 18px; } .slide-foot { left: 22px; right: 22px; } }
</style>
